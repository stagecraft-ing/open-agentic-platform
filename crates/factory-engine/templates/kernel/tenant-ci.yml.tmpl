# Tenant-side spec/code coupling gate (emitted by OAP spec 167).
#
# This workflow invokes the tenant-resident `spec-code-coupling-check`
# against the tenant's own spec spine. The tenant inherits the gate
# from OAP at project birth; updates to the gate are propagated via
# the kernel-update mechanism (follow-up spec, see `.kernel-version`).

name: CI spec/code coupling

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: read

jobs:
  coupling-check:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
        with:
          fetch-depth: 0

      - name: Verify tenant-resident spine binaries exist
        run: |
          set -eu
          for bin in codebase-indexer spec-code-coupling-check spec-compiler spec-lint; do
            if [ ! -x "@@binaries_dir@@/$bin" ]; then
              echo "missing tenant-resident binary: @@binaries_dir@@/$bin" >&2
              echo "the kernel emitter (OAP spec 167) is responsible for vendoring these binaries" >&2
              exit 2
            fi
          done

      - name: Refresh codebase index
        run: ./@@binaries_dir@@/codebase-indexer compile

      - name: Run spec-code-coupling-check
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          PR_BODY: ${{ github.event.pull_request.body }}
        run: |
          set -u
          body_file="$(mktemp)"
          printf '%s' "${PR_BODY:-}" > "$body_file"
          ./@@binaries_dir@@/spec-code-coupling-check \
              --base "$BASE_SHA" --head "$HEAD_SHA" --pr-body "$body_file"
