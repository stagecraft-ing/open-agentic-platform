# spec 168 — per-project governance certificate toolchain reference
#
# This file pins the emitter and verifier binaries the tenant project
# uses to produce and check its own governance certificates. Identity
# of these binaries plus their pinned factory-engine version is what
# the substrate's `.kernel-version` records (FR-001 / FR-008).
#
# Two distribution modes are supported (spec 167 FR-005):
#
# - vendor-binaries: tenant ships actual binaries under
#   @@binaries_dir@@. The `install` block below is then advisory — the
#   binaries are already present and the tenant CI calls them directly.
#
# - pinned-toolchain: tenant CI installs the binaries on demand. The
#   `install` block is the exact `cargo install` invocation that
#   reproduces the pinned versions.
#
# Spec 168 FR-009 — the binaries are deterministic; pinning by factory-
# engine version is sufficient to guarantee identical certificate hash
# inputs for identical artifact inputs.

mode: "@@toolchain_mode@@"

factory_engine:
  version: "@@factory_engine_version@@"
  install: "cargo install --git https://github.com/stagecraft-ing/open-agentic-platform.git --tag v@@factory_engine_version@@ --bin build-certificate --bin verify-certificate"

binaries:
  emitter:
    name: build-certificate
    invoke: "@@binaries_dir@@/build-certificate"
    docs: "https://github.com/stagecraft-ing/open-agentic-platform/blob/main/crates/factory-engine/src/bin/build_certificate.rs"
  verifier:
    name: verify-certificate
    invoke: "@@binaries_dir@@/verify-certificate"
    docs: "https://github.com/stagecraft-ing/open-agentic-platform/blob/main/crates/factory-engine/src/bin/verify_certificate.rs"

# Tenant-emit invocation (spec 168 FR-002): produce a governance
# certificate at the end of every pipeline run, with the principal's
# identity bound into the `signer` field (FR-003 / FR-007).
#
#   @@binaries_dir@@/build-certificate <run-dir> --tenant-mode \
#     --signer-subject <subject> \
#     --signer-identity-provider <provider> \
#     [--signer-session-id <id>] \
#     [--stage-ids <comma-separated>|auto]
#
# Tenant-verify invocation (spec 168 FR-004 / FR-005):
#
#   @@binaries_dir@@/verify-certificate <cert-path> \
#     [--artifact-dir <run-dir>]
