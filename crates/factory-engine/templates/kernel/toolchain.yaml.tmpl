# spec 168 / 219: per-project governance certificate toolchain reference
#
# This file records the toolchain a tenant project uses to produce and check
# its own governance certificates, and where each half comes from.
#
# Distribution (spec 219 FR-006): the VERIFIER is vended over npm as the
# `tenant-tail` package, pinned as an exact-version devDependency next to
# spec-spine. There is no tenant Rust toolchain (the npm migration removed it),
# so the historical source-install path that built the verifier from the OAP git
# repository is retired. `npm ci` sha512 lockfile verification is the integrity
# surface, and one pin covers every tenant-tail verb.
#
# The EMITTER (build-certificate) is NOT vended here. It is identity-bearing and
# harness-bound, and ships with its firing and signer identity in the emit spec
# (spec 220, residual R-2). Until that lands, a tenant inherits the ability to
# verify a certificate, not to emit one.
#
# `mode` and `binaries_dir` describe the adapter-determined fallback path (spec
# 167 OQ-6) for any tenant-resident binaries. They are recorded as provenance
# and do NOT govern the npm-vended verifier, which is mode-independent.

mode: "@@toolchain_mode@@"
binaries_dir: "@@binaries_dir@@"

factory_engine:
  # The factory-engine version whose behaviour the pinned toolchain vouches for
  # (spec 168 FR-009: the binaries are deterministic; pinning by version is
  # sufficient to guarantee identical certificate hash inputs).
  version: "@@factory_engine_version@@"

verifier:
  # Vended via the tenant-tail npm pin (spec 219 FR-006 / AC-8). Offline-capable,
  # identity-free: spec 102 do-not-trust-the-producer turned tenant-ward.
  name: verify-certificate
  package: "tenant-tail"
  invoke: "npx --no-install tenant-tail verify-certificate"
  docs: "https://github.com/bartekus/tenant-tail#readme"

emitter:
  # Deferred to spec 220 (residual R-2): the emitter, its firing, and the tenant
  # signer identity ship together. build-certificate is not vended by spec 219.
  name: build-certificate
  status: pending-spec-220

# Tenant-verify invocation (spec 168 FR-004 / FR-005, vended via spec 219):
#
#   npx --no-install tenant-tail verify-certificate <cert-path> \
#     [--artifact-dir <run-dir>]
#
# Tenant-emit invocation: pending spec 220 (residual R-2). When the emit leg
# lands, the emitter and its signer-identity flags are documented there.
