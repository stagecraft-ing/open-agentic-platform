      "Bash(cargo tree *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm exec *)",
      "Bash(pnpm install)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git config --get *)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git checkout *)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(gh repo view*)",
      "Bash(gh auth status)",
      "Bash(./tools/spec-spine/*/target/release/*)",
      "Bash(./tools/spec-spine/*/target/debug/*)",
      "Bash(./tools/oap/*/target/release/*)",
      "Bash(./tools/oap/*/target/debug/*)",
      "Bash(./tools/lint/*)",
      "Bash(./tools/lint/*/*)",
      "Bash(./crates/axiomregent/target/release/axiomregent*)",
      "Bash(./crates/*/target/release/*)",
      "Bash(./target/release/*)",
      "Bash(./target/debug/*)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(find . *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(ln -s *)",
      "Bash(chmod +x *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(rustc *)",
      "Bash(rustup *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(true)",
      "Bash(false)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "MultiEdit(**)",
      "WebFetch(*)",
      "WebSearch",
      "Glob",
      "Grep",
      "LS",
      "Task",
      "Agent(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push origin :*)",
      "Bash(git push upstream :*)",
      "Bash(git push * :HEAD*)",
      "Bash(git push * :refs/*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git worktree remove --force*)",
      "Bash(chmod -R *)",
      "Bash(cargo publish*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh release edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || { echo '[hook] jq missing — staleness check skipped'; exit 0; }; fp=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); case \"$fp\" in */Cargo.toml|*/package.json|*/pnpm-workspace.yaml|*/specs/*/spec.md|*/.claude/agents/*.md|*/.claude/commands/*.md|*/.claude/rules/*.md|*/.claude/skills/*/*.md|*/.claude/skills/*/*/*.md|*/.github/workflows/*.yml|*/.github/workflows/*.yaml|*/standards/schemas/*) [ -x ./tools/spec-spine/codebase-indexer/target/release/codebase-indexer ] && ./tools/spec-spine/codebase-indexer/target/release/codebase-indexer check 2>&1 | tail -5 ;; esac; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ./tools/spec-spine/codebase-indexer/target/release/codebase-indexer ]; then out=$(./tools/spec-spine/codebase-indexer/target/release/codebase-indexer check 2>&1); ec=$?; if [ $ec -ne 0 ]; then echo \"[codebase-index] stale - run: make index\"; echo \"$out\" | tail -10; fi; fi; true"
          }
        ]
      }
    ]
  }
}