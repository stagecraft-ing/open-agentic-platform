{
  "name": "stagecraft",
  "private": true,
  "version": "0.1.0",
  "description": "Stagecraft SaaS platform — auth, admin, project management, deployment orchestration",
  "license": "MPL-2.0",
  "type": "module",
  "oap": {
    "spec": "087-unified-workspace-architecture"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "test": "vitest",
    "encore": "BOOTSTRAP_ADMIN_EMAIL=admin@example.com encore run --port=4000 --debug",
    "start": "npm run gen && npm run build:frontend && npm run encore",
    "gen": "encore gen client --output=./web/app/lib/client.ts --env=local",
    "build:frontend": "cd web && react-router build"
  },
  "devDependencies": {
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@tanstack/react-query": "^5.101.0",
    "drizzle-orm": "^0.45.2",
    "encore.dev": "^1.57.8",
    "isbot": "^5.1.43",
    "knex": "^3.2.9",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.0"
  }
}
